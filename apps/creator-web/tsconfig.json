{
  "extends": "@koi/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@koi/creator-web/*": ["./src/*"],
      "@koi/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../../../apps/creator-web/src/providers.tsx"
  ],
  "exclude": ["node_modules"]
}

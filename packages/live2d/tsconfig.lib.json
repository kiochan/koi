{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "strictNullChecks": false,
    "paths": {
      "@external/framework/*": ["./src/external/framework/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/external/framework/src/**/*.ts"]
}

{
  "name": "@koi/editor",
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx electron-builder --config packages/editor/electron-builder.config.js"
        },
        "dependsOn": [
          "@koi/editor-main:build",
          "@koi/editor-web-ui:build"
        ],
        "parallel": true
      }
    }
  }
}

{
  "name": "@koi/editor-web-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/editor-web-ui",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx serve@latest out",
        "cwd": "packages/editor-web-ui"
      }
    },
    "add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node \"scripts/shadcn-add.js\"",
        "cwd": "packages/ui"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
